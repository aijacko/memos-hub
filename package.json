{
  "name": "memos-hub",
  "version": "1.0.1",
  "description": "Obsidian plugin for syncing Memos with per-file/daily-note modes, multi-account support, AI cleanup and Memos API compatibility",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint main.ts src",
    "lint:fix": "eslint --fix main.ts src",
    "test": "node scripts/run-tests.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "memos",
    "sync",
    "daily-notes",
    "emoji",
    "timeline"
  ],
  "author": "aijacko",
  "authorUrl": "https://github.com/aijacko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aijacko/memos-hub.git"
  },
  "homepage": "https://github.com/aijacko/memos-hub#readme",
  "bugs": {
    "url": "https://github.com/aijacko/memos-hub/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "esbuild": "0.17.3",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "obsidian-daily-notes-interface": "^0.9.4"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
